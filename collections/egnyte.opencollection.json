          "http": {
            "method": "GET",
            "url": "https://{domain}.egnyte.com/pubapi/v1/fs-content/:path",
            "params": [
              {
                "name": "path",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Download file content"
        },
        {
          "info": {
            "name": "Upload file content",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{domain}.egnyte.com/pubapi/v1/fs-content/:path",
            "params": [
              {
                "name": "path",
                "value": "",
                "type": "path"
              }
            ]
