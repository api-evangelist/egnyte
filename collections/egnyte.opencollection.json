{
  "opencollection": "1.0.0",
  "info": {
    "name": "Egnyte Public API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://{domain}.egnyte.com/puboauth/token",
      "accessTokenUrl": "https://{domain}.egnyte.com/puboauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
