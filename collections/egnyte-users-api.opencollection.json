              },
              {
                "name": "count",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List users"
        },
        {
          "info": {
            "name": "Create user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{domain}.egnyte.com/pubapi/v2/users",
