              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create user"
        },
        {
          "info": {
            "name": "Get user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{domain}.egnyte.com/pubapi/v2/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
